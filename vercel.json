{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://canmedseg-api.onrender.com/api/:path*"
    },
    {
      "source": "/mock-idp/:path*",
      "destination": "https://canmedseg-api.onrender.com/mock-idp/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
