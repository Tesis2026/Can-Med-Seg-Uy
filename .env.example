# API
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://canmedseg:canmedseg@localhost:5432/canmedseg
CORS_ORIGIN=http://localhost:5173
RUN_MIGRATIONS=true

# Base publica de la web (redirecciones post login/logout)
WEB_BASE_URL=http://localhost:5173

# Sesion (cookie httpOnly con token opaco)
SESSION_COOKIE_NAME=canmedseg_session
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Identidad: mock = IdP OIDC local en /mock-idp ; gubuy = endpoints reales
AUTH_PROVIDER=mock
OIDC_ISSUER=http://localhost:5173/mock-idp
OIDC_CLIENT_ID=canmedseg-local
OIDC_CLIENT_SECRET=canmedseg-local-secret
OIDC_SCOPE=openid email profile document
# URL a la que se redirige el navegador (pasa por el proxy de Vite en dev)
OIDC_AUTHORIZATION_URL=http://localhost:5173/mock-idp/authorize
# URLs servidor-a-servidor (la API llama directo a si misma / al IdP real)
OIDC_TOKEN_URL=http://127.0.0.1:3000/mock-idp/token
OIDC_USERINFO_URL=http://127.0.0.1:3000/mock-idp/userinfo
# Debe apuntar a GET /api/auth/callback tal como lo ve el navegador
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
OIDC_LOGIN_STATE_TTL_MINUTES=10

# Solo dev: siembra los roles de la cuenta mock en su primer ingreso.
# En produccion los roles los otorga el administrador (RF-2.4).
MOCK_IDP_SEED_ROLES=true

# CAPTCHA del envio anonimo (RF-3.6)
CAPTCHA_CHALLENGE_TTL_MINUTES=5
CAPTCHA_TOKEN_TTL_MINUTES=20
CAPTCHA_MAX_ATTEMPTS=4

# Caducidad de los borradores por inactividad (RF-4)
DRAFT_RETENTION_DAYS=90

# Web (vacio usa el proxy /api de Vite)
VITE_API_URL=

# A donde apunta el proxy de Vite si la API no esta en el 3000
API_PROXY_TARGET=http://localhost:3000
